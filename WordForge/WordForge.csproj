<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".codex\**" />
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".codex\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".codex\**" />
    <None Remove=".github\**" />
    <Page Remove=".codex\**" />
    <Page Remove=".github\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="resources\images\hamburger.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\images\hamburger.png" />
  </ItemGroup>

</Project>
