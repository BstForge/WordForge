<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WordForge.Desktop.App"
             xmlns:vm="clr-namespace:WordForge.Desktop.ViewModels"
             xmlns:views="clr-namespace:WordForge.Desktop.Views">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:CharacterPaneViewModel}">
            <views:CharacterPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationPaneViewModel}">
            <views:LocationPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemPaneViewModel}">
            <views:ItemPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelinePaneViewModel}">
            <views:TimelinePane />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
